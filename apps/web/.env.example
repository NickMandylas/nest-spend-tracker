# Banking data from https://redbark.com/
REDBARK_API_KEY=rbk_live_your_key_here
REDBARK_API_VERSION=2026-10-01.wattle

# Powers the Nest Eve assistant through Vercel AI Gateway
AI_GATEWAY_API_KEY=vck_your_key_here

# Enables public web search and page scraping for the Nest Eve assistant
FIRECRAWL_API_KEY=fc_your_key_here

# Optional. Defaults to ../../data/spend-tracker.sqlite from apps/web.
# SPEND_TRACKER_DB_PATH=../../data/spend-tracker.sqlite
